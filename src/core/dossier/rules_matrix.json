    "docTypeMeta": {
        "IDENTITY": {
            "title": "Pièce d’identité",
            "why": "Permet de vérifier l’identité du signataire ou du garant.",
            "examples": [
                "CNI",
                "Passeport",
                "Titre de séjour (peut aussi couvrir RESIDENCY_RIGHT selon cas)"
            ]
        },
        "RESIDENCY_RIGHT": {
            "title": "Droit au séjour",
            "why": "Permet de justifier le droit au séjour pour les profils hors UE.",
            "examples": [
                "Titre de séjour",
                "Visa long séjour",
                "Carte de résident"
            ]
        },
        "STUDENT_ENROLLMENT": {
            "title": "Justificatif de scolarité",
            "why": "Confirme le statut étudiant.",
            "examples": [
                "Certificat de scolarité",
                "Attestation d’inscription",
                "Carte étudiante"
            ]
        },
        "PROFESSIONAL_STATUS_PROOF": {
            "title": "Justificatif de situation professionnelle",
            "why": "Permet d’établir la situation professionnelle.",
            "examples": [
                "Contrat de travail",
                "Attestation employeur",
                "Extrait d’immatriculation / preuve d’activité"
            ]
        },
        "INCOME_PROOF": {
            "title": "Justificatif de ressources",
            "why": "Permet d’évaluer la capacité financière.",
            "examples": [
                "Bulletins de salaire",
                "Attestation de pension",
                "Justificatif d’allocations (si applicable)"
            ]
        },
        "TAX_NOTICE": {
            "title": "Avis d’imposition",
            "why": "Justifie les revenus de manière stable.",
            "examples": [
                "Avis d’imposition"
            ]
        },
        "ADDRESS_PROOF": {
            "title": "Justificatif de domicile",
            "why": "Permet de vérifier l’adresse de la personne.",
            "examples": [
                "Facture",
                "Quittance",
                "Attestation d’hébergement (selon cas)"
            ]
        },
        "GUARANTEE_CERTIFICATE": {
            "title": "Attestation de garantie",
            "why": "Justifie une garantie via un organisme.",
            "examples": [
                "Visale",
                "GarantMe",
                "Autre attestation de garantie"
            ]
        }
    },
